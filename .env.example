# ---------------------------------------------------------------------
#  Copia este fichero como ".env" y cambia TODAS las contraseñas.
#  El fichero .env no se sube a GitHub (está en .gitignore).
# ---------------------------------------------------------------------

# Solo para Docker / pruebas en local: contraseña de root de MariaDB.
# En el servidor Debian no hace falta (root entra con sudo).
MARIADB_ROOT_PASSWORD=cambia_esto_root

# Usuarios de MariaDB que usa la aplicación (uno por perfil).
# Sin comillas simples ni espacios en las contraseñas.
DB_ADMIN_PASSWORD=cambia_esto_admin
DB_DEPENDIENTE_PASSWORD=cambia_esto_dependiente
DB_AUTH_PASSWORD=cambia_esto_auth

# Desde dónde se pueden conectar esos usuarios:
#   '%'          -> Docker / pruebas en local
#   '127.0.0.1'  -> servidor de la tienda (la web está en el mismo servidor)
DB_HOST_PERMITIDO=%

# Dónde está MariaDB para el backend
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Asistente virtual. Sin clave, la web funciona pero el chat queda desactivado.
# Consigue una en https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Origen del frontend en desarrollo
CORS_ORIGINS=http://localhost:5173
